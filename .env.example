APP_ENV=development
SECRET_KEY=default-api-fast-secret
DB_NAME=default_api_fast
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_ADMIN_DATABASE=postgres
# Optional override if you want a full URI instead of components.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/default_api_fast_development

# Storage (local or s3)
STORAGE_SERVICE=local
STORAGE_LOCAL_ROOT=storage
STORAGE_LOCAL_PUBLIC_ENDPOINT=/files
STORAGE_MAX_CONTENT_LENGTH_MB=100

# AWS credentials and region for S3 or SQS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# S3 (only when STORAGE_SERVICE=s3)
STORAGE_S3_BUCKET=
# Optional override. Defaults to AWS_REGION when unset.
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PREFIX=
STORAGE_S3_PUBLIC_URL=
STORAGE_S3_PRESIGNED_EXPIRES_IN=3600
STORAGE_S3_ACL=

# SQS
SQS_QUEUE=
